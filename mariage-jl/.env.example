# Copier en .env.local pour le développement. Aucun secret ne vit dans le dépôt.

# Base de données. En local : ./scripts/pg-local.sh start
JL_DATABASE_URL=postgres://postgres@127.0.0.1:55432/jl_dev

# Signature des cookies de foyer. 32 caractères minimum.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JL_COOKIE_SECRET=

# Horloge simulable pour les tests de bascule de période. Jamais 1 en production.
JL_ALLOW_CLOCK_OVERRIDE=0

# Étiquette de version affichée par /api/health.
JL_VERSION=v1-dev

# Film d'annonce (question V0-09). Vide = l'accueil affiche une carte d'attente.
JL_FILM_URL=
JL_FILM_POSTER_URL=

# La promesse : clé publique de scellement des vœux (brief §8.10).
# Générer la paire : pnpm promesse:cles  — la clé privée ne va JAMAIS ici.
JL_PROMESSE_CLE_PUBLIQUE=

# Web Push (brief §5). Générer la paire : pnpm push:cles
JL_VAPID_CLE_PUBLIQUE=
JL_VAPID_CLE_PRIVEE=
# Adresse de contact exigée par la norme VAPID, au format mailto:
JL_VAPID_CONTACT=

# Transport e-mail. « console » écrit les e-mails dans la sortie standard sans
# jamais les envoyer : c'est le réglage tant que le prestataire n'est pas choisi.
JL_EMAIL_TRANSPORT=console

# Dossier des souvenirs envoyés par les invités (brief §8.7). À SAUVEGARDER :
# c'est le seul endroit où vivent les photos et les vidéos.
JL_MEDIAS_DIR=.medias
# Poids maximal d'un envoi, en mégaoctets. La durée des vidéos est déjà
# bornée à 60 secondes par l'arbitrage de la section 0 bis.
JL_MEDIA_MAX_MO=120

# Météo de la semaine J (brief §0 bis). « latitude,longitude » du domaine,
# une fois la question V1-07 répondue. Vide = l'écran se tait.
JL_METEO_COORDONNEES=
