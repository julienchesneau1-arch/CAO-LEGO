# Copier en .env.local pour le développement. Aucun secret ne vit dans le dépôt.

# Base de données. En local : ./scripts/pg-local.sh start
JL_DATABASE_URL=postgres://postgres@127.0.0.1:55432/jl_dev

# Signature des cookies de foyer. 32 caractères minimum.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JL_COOKIE_SECRET=

# Horloge simulable pour les tests de bascule de période. Jamais 1 en production.
JL_ALLOW_CLOCK_OVERRIDE=0

# Étiquette de version affichée par /api/health.
JL_VERSION=v1-dev

# Film d'annonce (question V0-09). Vide = l'accueil affiche une carte d'attente.
JL_FILM_URL=
JL_FILM_POSTER_URL=

# La promesse : clé publique de scellement des vœux (brief §8.10).
# Générer la paire : pnpm promesse:cles  — la clé privée ne va JAMAIS ici.
JL_PROMESSE_CLE_PUBLIQUE=
