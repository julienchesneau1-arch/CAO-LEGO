{
  "name": "mariage-jl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "L'application du mariage de Julien & Lauriane — 3 juin 2028",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-i18n.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "check:i18n": "node scripts/check-i18n.mjs",
    "gen:monogram": "node scripts/build-monogram.mjs",
    "verify": "pnpm run check:i18n && pnpm run lint && pnpm run test && pnpm run build",
    "gen:secours": "node scripts/build-secours.mjs",
    "captures": "node scripts/captures.mjs",
    "db:local": "./scripts/pg-local.sh start",
    "db:stop": "./scripts/pg-local.sh stop",
    "db:seed": "node scripts/seed-dev.mjs",
    "test:e2e": "node scripts/e2e-prepare.mjs && playwright test",
    "admin:lien": "node scripts/admin-lien.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "polices": "node scripts/telecharger-polices.mjs",
    "gen:icone": "node scripts/build-icone.mjs"
  },
  "dependencies": {
    "next": "16.3.5",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.4.1",
    "opentype.js": "2.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.1",
    "wawoff2": "^2.0.1"
  }
}
